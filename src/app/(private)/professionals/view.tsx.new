import React, { useState } from "react"
import {
  Button,
  Divider,
  Modal,
  ModalBody,
  ModalContent,
  ModalFooter,
  ModalHeader,
  Spinner,
  Table,
  TableBody,
  TableCell,
  TableColumn,
  TableHeader,
  TableRow,
  useDisclosure,
  Tooltip,
} from "@nextui-org/react"
import { DashboardLayout } from "@/app/layout/dashboard-layout"
import useProfessionalPageModel from "./model"
import CreateProfessional from "./components/CreateProfessional"
import { Eye, Edit, Trash2 } from "lucide-react"
import { useRouter } from "next/navigation"
import { toast } from "sonner"
import { UUID } from "crypto"

// Interface para tipagem do profissional
interface Professional {
  id: UUID | string;
  nome: string;
  formacao: string;
  registro: string;
  email: string;
  telefone: string;
  especialidade: string;
  atende_cat_idade: any; // Usando any para evitar problemas de tipagem
  convenios_aceitos: any; // Usando any para evitar problemas de tipagem
  horarios_atendimento: Record<string, any>; // Usando any para evitar problemas de tipagem
  scheduler?: Record<string, any>; // Alias para horarios_atendimento
  especialidades?: Array<any>;
  observacoes?: string | null;
}

export default function ProfessionalPageView({
  loading,
  showForm,
  setShowForm,
  professionals,
  deleteProfessional,
}: ReturnType<typeof useProfessionalPageModel>) {
  const { isOpen, onOpen, onClose } = useDisclosure()
  const router = useRouter()
  const [selectedProfessional, setSelectedProfessional] = useState<Professional | null>(null)
  const [isDeleting, setIsDeleting] = useState(false)
  
  // Função para abrir o modal de visualização
  const handleViewProfessional = (professional: any) => {
    setSelectedProfessional(professional as Professional)
    onOpen()
  }
  
  // Função para redirecionar para a página de edição
  const handleEditProfessional = (professional: Professional) => {
    router.push(`/professionals/${professional.id}`)
  }
  
  // Função para confirmar e executar a exclusão
  const handleDeleteProfessional = async (professional: Professional) => {
    if (confirm(`Tem certeza que deseja excluir o profissional ${professional.nome}?`)) {
      try {
        setIsDeleting(true)
        await deleteProfessional(professional.id)
        toast.success("Profissional excluído com sucesso")
      } catch (error) {
        console.error("Erro ao excluir profissional:", error)
        toast.error("Erro ao excluir profissional")
      } finally {
        setIsDeleting(false)
      }
    }
  }

  return (
    <DashboardLayout>
      <div className="container mx-auto py-6">
        <div className="flex justify-between items-center mb-6">
          <h1 className="text-3xl font-bold">Profissionais</h1>
          {!showForm && (
            <Button
              color="primary"
              onPress={() => setShowForm(true)}
              disabled={loading}
              radius="sm"
            >
              Adicionar Profissional
            </Button>
          )}
        </div>

        {loading && (
          <div className="flex justify-center items-center p-10">
            <Spinner size="lg" label="Carregando..." />
          </div>
        )}

        {showForm ? (
          <CreateProfessional setShowForm={setShowForm} />
        ) : (
          !loading && (
            <>
              {professionals.length > 0 ? (
                <Table
                  aria-label="Tabela de profissionais"
                  selectionMode="none"
                  shadow="sm"
                  className="rounded-md"
                >
                  <TableHeader>
                    <TableColumn>NOME</TableColumn>
                    <TableColumn>ESPECIALIDADE</TableColumn>
                    <TableColumn>REGISTRO</TableColumn>
                    <TableColumn>CONTATO</TableColumn>
                    <TableColumn>AÇÕES</TableColumn>
                  </TableHeader>
                  <TableBody>
                    {professionals.map((professional) => (
                      <TableRow key={professional.id}>
                        <TableCell>{professional.nome}</TableCell>
                        <TableCell>{professional.especialidade}</TableCell>
                        <TableCell>{professional.registro}</TableCell>
                        <TableCell>
                          <div className="flex flex-col">
                            <span>{professional.email}</span>
                            <span>{professional.telefone}</span>
                          </div>
                        </TableCell>
                        <TableCell>
                          <div className="flex items-center gap-2">
                            <Tooltip content="Visualizar">
                              <Button
                                isIconOnly
                                size="sm"
                                variant="light"
                                onPress={() => handleViewProfessional(professional)}
                              >
                                <Eye size={16} />
                              </Button>
                            </Tooltip>
                            <Tooltip content="Editar">
                              <Button
                                isIconOnly
                                size="sm"
                                variant="light"
                                onPress={() => handleEditProfessional(professional)}
                              >
                                <Edit size={16} />
                              </Button>
                            </Tooltip>
                            <Tooltip content="Excluir">
                              <Button
                                isIconOnly
                                size="sm"
                                variant="light"
                                color="danger"
                                isLoading={isDeleting}
                                onPress={() => handleDeleteProfessional(professional)}
                              >
                                <Trash2 size={16} />
                              </Button>
                            </Tooltip>
                          </div>
                        </TableCell>
                      </TableRow>
                    ))}
                  </TableBody>
                </Table>
              ) : (
                <div className="text-center p-10 bg-gray-50 rounded-md">
                  <p className="text-gray-500">
                    Nenhum profissional cadastrado. Clique em "Adicionar
                    Profissional" para começar.
                  </p>
                </div>
              )}
            </>
          )
        )}
      </div>

      <Modal isOpen={isOpen} onOpenChange={onClose}>
        <ModalContent>
          {(onClose) => (
            <>
              <ModalHeader className="flex flex-col gap-1">
                {selectedProfessional?.nome}
              </ModalHeader>
              <ModalBody>
                {selectedProfessional && (
                  <div className="space-y-6">
                    <div className="grid grid-cols-2 gap-4">
                      <div>
                        <h3 className="text-sm font-medium text-gray-500 mb-1">
                          Formação
                        </h3>
                        <p>{selectedProfessional.formacao}</p>
                      </div>
                      <div>
                        <h3 className="text-sm font-medium text-gray-500 mb-1">
                          Registro
                        </h3>
                        <p>{selectedProfessional.registro}</p>
                      </div>
                      <div>
                        <h3 className="text-sm font-medium text-gray-500 mb-1">
                          Email
                        </h3>
                        <p>{selectedProfessional.email}</p>
                      </div>
                      <div>
                        <h3 className="text-sm font-medium text-gray-500 mb-1">
                          Telefone
                        </h3>
                        <p>{selectedProfessional.telefone}</p>
                      </div>
                    </div>

                    <Divider />

                    <div>
                      <h3 className="text-sm font-medium text-gray-500 mb-2">
                        Categorias de Atendimento
                      </h3>
                      <div className="flex flex-wrap gap-2">
                        {selectedProfessional.atende_cat_idade && (
                          <>
                            {(selectedProfessional.atende_cat_idade.adulto ===
                              true ||
                              selectedProfessional.atende_cat_idade.adulto ===
                                "true" ||
                              selectedProfessional.atende_cat_idade.adulto ===
                                "on") && (
                              <span className="bg-primary/10 text-primary px-2 py-1 rounded-full text-xs">
                                Adulto
                              </span>
                            )}
                            {(selectedProfessional.atende_cat_idade.idoso ===
                              true ||
                              selectedProfessional.atende_cat_idade.idoso ===
                                "true" ||
                              selectedProfessional.atende_cat_idade.idoso ===
                                "on") && (
                              <span className="bg-primary/10 text-primary px-2 py-1 rounded-full text-xs">
                                Idoso
                              </span>
                            )}
                            {(selectedProfessional.atende_cat_idade.crianca ===
                              true ||
                              selectedProfessional.atende_cat_idade.crianca ===
                                "true" ||
                              selectedProfessional.atende_cat_idade.crianca ===
                                "on") && (
                              <span className="bg-primary/10 text-primary px-2 py-1 rounded-full text-xs">
                                Criança
                              </span>
                            )}
                            {(selectedProfessional.atende_cat_idade
                              .adolescente === true ||
                              selectedProfessional.atende_cat_idade
                                .adolescente === "true" ||
                              selectedProfessional.atende_cat_idade
                                .adolescente === "on") && (
                              <span className="bg-primary/10 text-primary px-2 py-1 rounded-full text-xs">
                                Adolescente
                              </span>
                            )}
                          </>
                        )}
                      </div>
                    </div>

                    {selectedProfessional.convenios_aceitos && (
                      <>
                        <Divider />
                        <div>
                          <h3 className="text-sm font-medium text-gray-500 mb-2">
                            Convênios Aceitos
                          </h3>
                          <div className="flex flex-wrap gap-2">
                            {Array.isArray(selectedProfessional.convenios_aceitos) ? (
                              selectedProfessional.convenios_aceitos.map(
                                (convenio: string, index: number) => (
                                  <div
                                    key={index}
                                    className="px-2 py-1 bg-primary/10 text-primary rounded-md text-xs"
                                  >
                                    {convenio}
                                  </div>
                                )
                              )
                            ) : (
                              Object.entries(selectedProfessional.convenios_aceitos).map(
                                ([convenio, aceita]) => 
                                  aceita ? (
                                    <div
                                      key={convenio}
                                      className="px-2 py-1 bg-primary/10 text-primary rounded-md text-xs"
                                    >
                                      {convenio}
                                    </div>
                                  ) : null
                              )
                            )}
                          </div>
                        </div>
                      </>
                    )}

                    {(selectedProfessional.scheduler || selectedProfessional.horarios_atendimento) && (
                      <>
                        <Divider />
                        <div>
                          <h3 className="text-sm font-medium text-gray-500 mb-2">
                            Horários de Atendimento
                          </h3>
                          <div className="grid grid-cols-1 md:grid-cols-2 gap-2">
                            {Object.entries(
                              selectedProfessional.scheduler || selectedProfessional.horarios_atendimento
                            ).map(([day, schedule]) => {
                              const dayNames: Record<string, string> = {
                                monday: "Segunda-feira",
                                tuesday: "Terça-feira",
                                wednesday: "Quarta-feira",
                                thursday: "Quinta-feira",
                                friday: "Sexta-feira",
                                saturday: "Sábado",
                                sunday: "Domingo",
                              }

                              const scheduleObj = schedule as any;
                              return scheduleObj.enabled === true ||
                                scheduleObj.enabled === "true" ||
                                scheduleObj.enabled === "on" ? (
                                <div key={day} className="border rounded p-2">
                                  <p className="font-medium">{dayNames[day]}</p>
                                  <p className="text-sm">
                                    {scheduleObj.opening} - {scheduleObj.closing}
                                  </p>
                                </div>
                              ) : null
                            })}
                          </div>
                        </div>
                      </>
                    )}
                    
                    {selectedProfessional.observacoes && (
                      <>
                        <Divider />
                        <div>
                          <h3 className="text-sm font-medium text-gray-500 mb-2">
                            Observações
                          </h3>
                          <p className="text-sm">{selectedProfessional.observacoes}</p>
                        </div>
                      </>
                    )}
                    
                    {selectedProfessional.especialidades && selectedProfessional.especialidades.length > 0 && (
                      <>
                        <Divider />
                        <div>
                          <h3 className="text-sm font-medium text-gray-500 mb-2">
                            Especialidades
                          </h3>
                          <div className="flex flex-wrap gap-2">
                            {selectedProfessional.especialidades.map((especialidade: any) => (
                              <div
                                key={especialidade.id || especialidade.nome || Math.random()}
                                className="px-2 py-1 bg-primary/10 text-primary rounded-md text-xs"
                              >
                                {especialidade.nome || especialidade}
                              </div>
                            ))}
                          </div>
                        </div>
                      </>
                    )}
                  </div>
                )}
              </ModalBody>
              <ModalFooter>
                <Button variant="light" onPress={onClose}>
                  Fechar
                </Button>
                <Button
                  color="primary"
                  onPress={() => {
                    onClose();
                    if (selectedProfessional) handleEditProfessional(selectedProfessional);
                  }}
                >
                  Editar
                </Button>
              </ModalFooter>
            </>
          )}
        </ModalContent>
      </Modal>
    </DashboardLayout>
  )
}
