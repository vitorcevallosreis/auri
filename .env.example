# Supabase (novo projeto que controlamos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_URL=

# MinIO / S3 (storage de mídia)
MINIO_ENDPOINT=
MINIO_SERVER_URL=
MINIO_PUBLIC_URL=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Webhook (Agent Service / integração)
NEXT_PUBLIC_WEBHOOK=

# --- WhatsApp Cloud API (Meta) — Plano 3 -----------------------------------
# SERVER-ONLY. Nunca usar prefixo NEXT_PUBLIC_ exceto onde indicado: o browser
# não fala com a Graph API, e o App Secret assina os webhooks.

# App Meta. O App Secret verifica a assinatura HMAC do webhook e assina a troca
# de code do Embedded Signup.
META_APP_ID=
META_APP_SECRET=

# O App ID também é lido pelo JS SDK do Embedded Signup no browser — mesmo
# valor, e não é segredo (o secret é que é).
NEXT_PUBLIC_META_APP_ID=

# Token arbitrário que escolhemos; a Meta ecoa no handshake GET do webhook.
# Gere com: openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=

# Versão da Graph API. Default no código é v21.0; fixar aqui evita que uma
# depreciação da Meta quebre o app sem aviso.
META_GRAPH_VERSION=v21.0

# Chave AES-256 que cifra o access token de cada clínica antes de gravar em
# myia_wa_cloud_numbers. 32 bytes em base64.
# Gere com: openssl rand -base64 32
# ATENÇÃO: perder esta chave inutiliza todos os tokens salvos — as clínicas
# precisariam reconectar o número.
WHATSAPP_TOKEN_ENC_KEY=

# --- Evolution API (Plano 2) — EM REMOÇÃO ----------------------------------
# O Plano 3 decidiu que a Cloud API substitui o Evolution. Estas envs saem
# junto com o código do Evolution, ao final da fase P3.1.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# URL pública do próprio app (ex: https://app.SEUDOMINIO.com.br). Usada no bloco
# webhook do /instance/create para o Evolution chamar nosso ingress. É só a URL
# pública (não é segredo), por isso pode ter prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_APP_URL=

# Mapbox
NEXT_PUBLIC_MAPBOX_KEY=

# --- Agente IA (Plano 3, P3.3) -----------------------------------------------
# SERVER-ONLY, e na prática só o WORKER usa: o app Next.js nunca fala com a
# Anthropic. Nunca prefixar com NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Modelo é escolha NOSSA, não da clínica (decisão do Plano 3). O seletor de LLM
# sai da UI; myia_assistants.llm vira registro interno de ops.
AGENT_MODEL=claude-opus-5

# Latência do agente se controla por effort, NUNCA desligando o thinking: em
# Opus 5, thinking desligado tem um modo de falha em que a tool call sai como
# texto simples e a ferramenta nunca roda — inaceitável para agenda.
AGENT_EFFORT=medium
AGENT_MAX_TOKENS=8000

# Quantas mensagens do chat entram no contexto do turno.
AGENT_HISTORY_LIMIT=40

# TTL do cache do system prompt. 1h é o default: com 5min o prefixo expira entre
# um paciente e outro numa clínica de baixo volume, e ela paga 1x sempre.
AGENT_CACHE_TTL=1h

# Janela de coalescência do debounce (P3.2), em segundos.
AGENT_DEBOUNCE_SECONDS=3

# --- Worker (Plano 3, P3.2) --------------------------------------------------
# DESLIGADO por padrão. Ligar só quando o turno estiver validado contra o
# modelo de verdade — um worker ligado consome jobs sem responder ao paciente.
AGENT_TURN_ENABLED=false

# Envio da resposta ao paciente. Flag SEPARADO de AGENT_TURN_ENABLED de
# propósito: com o turno ligado e o envio desligado, o agente gera a resposta e
# ela fica PENDING na inbox para revisão humana — bom para os primeiros dias.
AGENT_SEND_ENABLED=false
WORKER_POLL_INTERVAL_MS=1000
WORKER_CLAIM_BATCH=10
WORKER_REAP_TIMEOUT_SECONDS=300

# Escuta assistida do prontuário (0025). Sem as duas, a tela mostra
# "não configurada" e o microfone fica desligado.
# Provedor de transcrição — ver src/lib/escuta/transcricao.ts para os disponíveis.
TRANSCRICAO_PROVIDER=deepgram
TRANSCRICAO_API_KEY=
TRANSCRICAO_MODELO=nova-3-medical
# Redação do rascunho usa ANTHROPIC_API_KEY (já declarada acima).
ESCUTA_MODEL=claude-opus-5

# Prescrição digital Memed (0026). Sem as duas chaves, o botão "Prescrever"
# aparece explicando que a integração não está configurada.
# A SECRET nunca pode chegar ao front-end — só o token do prescritor sai daqui.
# Chaves públicas de HOMOLOGAÇÃO estão em doc.memed.com.br/docs/primeiros-passos;
# as de produção vêm da validação técnica com a Memed.
MEMED_API_KEY=
MEMED_SECRET_KEY=
MEMED_API_URL=https://integrations.api.memed.com.br/v1
MEMED_SCRIPT_URL=https://integrations.memed.com.br/modulos/plataforma.sinapse-prescricao/build/sinapse-prescricao.min.js
