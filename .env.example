# Supabase (novo projeto que controlamos)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_STORAGE_URL=

# MinIO / S3 (storage de mídia)
MINIO_ENDPOINT=
MINIO_SERVER_URL=
MINIO_PUBLIC_URL=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Webhook (Agent Service / integração)
NEXT_PUBLIC_WEBHOOK=

# --- WhatsApp Cloud API (Meta) — Plano 3 -----------------------------------
# SERVER-ONLY. Nunca usar prefixo NEXT_PUBLIC_ exceto onde indicado: o browser
# não fala com a Graph API, e o App Secret assina os webhooks.

# App Meta. O App Secret verifica a assinatura HMAC do webhook e assina a troca
# de code do Embedded Signup.
META_APP_ID=
META_APP_SECRET=

# O App ID também é lido pelo JS SDK do Embedded Signup no browser — mesmo
# valor, e não é segredo (o secret é que é).
NEXT_PUBLIC_META_APP_ID=

# Token arbitrário que escolhemos; a Meta ecoa no handshake GET do webhook.
# Gere com: openssl rand -hex 32
META_WEBHOOK_VERIFY_TOKEN=

# Versão da Graph API. Default no código é v21.0; fixar aqui evita que uma
# depreciação da Meta quebre o app sem aviso.
META_GRAPH_VERSION=v21.0

# Chave AES-256 que cifra o access token de cada clínica antes de gravar em
# myia_wa_cloud_numbers. 32 bytes em base64.
# Gere com: openssl rand -base64 32
# ATENÇÃO: perder esta chave inutiliza todos os tokens salvos — as clínicas
# precisariam reconectar o número.
WHATSAPP_TOKEN_ENC_KEY=

# --- Evolution API (Plano 2) — EM REMOÇÃO ----------------------------------
# O Plano 3 decidiu que a Cloud API substitui o Evolution. Estas envs saem
# junto com o código do Evolution, ao final da fase P3.1.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# URL pública do próprio app (ex: https://app.SEUDOMINIO.com.br). Usada no bloco
# webhook do /instance/create para o Evolution chamar nosso ingress. É só a URL
# pública (não é segredo), por isso pode ter prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_APP_URL=

# Mapbox
NEXT_PUBLIC_MAPBOX_KEY=
