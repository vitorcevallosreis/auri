# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NEVER commit secrets)
.env
.env.*
_env
!.env.example

# QUALQUER arquivo .env, com qualquer nome. As regras acima só pegam nomes que
# começam com ".env" — um arquivo chamado `runtime-api-keys.env` passava por
# elas e seria commitado. Aconteceu em 04/08/2026, com uma chave de API dentro;
# foi pego antes do `git add`, mas por sorte e não por regra.
*.env
!example.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local artifacts
supabase/.branches
supabase/.temp

# subagent-driven-development scratch
.superpowers/
